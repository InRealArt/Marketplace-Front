# ─── Dépendances ─────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ─── Build & artefacts Next.js ───────────────────────────────────────────────
.next/
out/
build/
.vercel/

# ─── Prisma (auto-généré) ─────────────────────────────────────────────────────
prisma/generated/
prisma/migrations/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Cache & logs ─────────────────────────────────────────────────────────────
.eslintcache
*.log
npm-debug.log*

# ─── Outils tiers (non pertinents pour le code) ──────────────────────────────
.git/
.history/
.qodo/
.agents/
.claude/

# ─── Tests & rapports ─────────────────────────────────────────────────────────
playwright-report/
test-results/
coverage/

# ─── Assets statiques ─────────────────────────────────────────────────────────
public/

# ─── Données mockées ──────────────────────────────────────────────────────────
src/mocks/

# ─── Environnement (secrets) ──────────────────────────────────────────────────
.env
.env.local
.env*.local
.env.production
.env.development
