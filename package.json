{
  "name": "ira-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3008",
    "lint": "next lint",
    "prettier": "prettier --write .",
    "migrate-dev": "npx prisma migrate dev && npx tsx lib/seedTriggers.ts",
    "preinstall": "node scripts/prepare-vercel-install.js",
    "install:safe": "dotenv-cli -e .env -- npm install --legacy-peer-deps",
    "install:safe:prisma": "npx dotenv-cli -e .env -- npm install @InRealArt/prisma-schema",
    "prisma:copy-schema": "cp node_modules/@InRealArt/prisma-schema/schema.prisma prisma/schema.prisma",
    "prisma:generate": "npm run prisma:copy-schema && prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@getbrevo/brevo": "^1.0.1",
    "@hookform/resolvers": "^3.4.0",
    "@nextui-org/react": "^2.2.9",
    "@prisma/client": "^5.13.0",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@reduxjs/toolkit": "^2.2.3",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.43.2",
    "@tanstack/react-query": "^5.66.8",
    "@types/shippo": "^1.7.8",
    "apexcharts": "^3.45.2",
    "better-auth": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "nuqs": "^2.4.3",
    "pino-pretty": "^10.3.1",
    "postgres": "^3.4.4",
    "prisma": "^5.13.0",
    "react": "^19.1.0",
    "react-apexcharts": "^1.4.1",
    "react-dom": "^19.1.0",
    "react-google-autocomplete": "^2.7.3",
    "react-google-recaptcha-v3": "^1.10.1",
    "react-hook-form": "^7.51.4",
    "react-phone-number-input": "^3.4.12",
    "react-redux": "^9.1.2",
    "shippo": "^2.15.0",
    "sonner": "^1.4.0",
    "stripe": "^17.7.0",
    "swiper": "^11.0.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.10.5",
    "uuid": "^10.0.0",
    "view": "^0.6.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/stripe-v3": "^3.1.33",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "encoding": "^0.1.13",
    "eslint": "^8",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.4.38",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5"
  },
  "resolutions": {
    "sucrase/minimatch": "^10.0.3",
    "sucrase/glob": "^10.3.10",
    "sucrase/brace-expansion": "^2.0.1"
  }
}
